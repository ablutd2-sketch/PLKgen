import React, { useState } from "react";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
import { MapPin } from "lucide-react";

export default function StationForm({ onSubmit, loading }) {
  const [name, setName] = useState("");

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!name.trim()) return;
    onSubmit({ name: name.trim() });
    setName("");
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-5">
      <div className="space-y-2">
        <Label htmlFor="station-name" className="text-amber-200/80 text-sm font-medium tracking-wide uppercase">
          Nazwa stacji
        </Label>
        <div className="relative">
          <MapPin className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-amber-400/60" />
          <Input
            id="station-name"
            value={name}
            onChange={(e) => setName(e.target.value)}
            placeholder="np. Warszawa Centralna"
            className="pl-10 bg-slate-800/60 border-slate-600/50 text-white placeholder:text-slate-500 focus:border-amber-400/60 focus:ring-amber-400/20 h-12"
          />
        </div>
      </div>
      <Button
        type="submit"
        disabled={loading || !name.trim()}
        className="w-full h-12 bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold tracking-wide transition-all duration-200"
      >
        {loading ? "Dodawanie..." : "Dodaj stację"}
      </Button>
    </form>
  );
}
